APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_agent
CODEX_EXECUTABLE=codex
# Empty uses the CLI default model.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120
GROQ_API_KEY=
GROQ_MODEL=
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
TAVILY_SEARCH_URL=https://api.tavily.com/search
DEFILLAMA_PRO_BASE_URL=https://pro-api.llama.fi
DEFILLAMA_PROTOCOLS_URL=https://api.llama.fi/protocols
DEFILLAMA_RAISES_URL=https://defillama.com/raises
GROQ_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
TAVILY_API_KEY=
RESEARCH_TIMEOUT_SECONDS=240
# Optional JSON overrides, e.g. {"website":10,"https":2}
COMPANY_SCORE_WEIGHTS={}
RESUME_MAX_BYTES=10485760
RESUME_MAX_PAGES=20
RESUME_MAX_CHARACTERS=50000
RESUME_PARSE_TIMEOUT_SECONDS=15
RESUME_ANALYSIS_TIMEOUT_SECONDS=180
OPPORTUNITY_TIMEOUT_SECONDS=360
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/embeddings
EMBEDDING_TIMEOUT_SECONDS=60
SEMANTIC_MATCH_THRESHOLD=0.88
CONTACT_LIMIT=10
CONTACT_TIMEOUT_SECONDS=150
OUTREACH_TIMEOUT_SECONDS=180
# DefiLlama API-plan credential, separate from Tavily.
DEFILLAMA_API_KEY=
DISCOVERY_COMPANY_TIMEOUT_SECONDS=600
FUNDING_DISCOVERY_TIMEOUT_SECONDS=240
